# Supabase — public (shipped to the browser; safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ntfy — server-only (NEVER prefix with NEXT_PUBLIC_; the topic name is a secret)
# Use an unguessable random topic so customer PII is not exposed on a public channel.
NTFY_TOPIC=your-unguessable-random-topic
# Optional: bearer token for authenticated/reserved ntfy topics. Leave blank if unused.
NTFY_TOKEN=
