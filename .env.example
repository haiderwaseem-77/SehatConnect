# Supabase — public (shipped to the browser; safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ntfy — server-only (NEVER prefix with NEXT_PUBLIC_; the topic name is a secret)
# Use an unguessable random topic so customer PII is not exposed on a public channel.
NTFY_TOPIC=your-unguessable-random-topic
# Optional: bearer token for authenticated/reserved ntfy topics. Leave blank if unused.
NTFY_TOKEN=

# GA4 — public measurement ID (G-XXXXXXXXXX).
# Leave unset and analytics is completely inert: the script never loads and no
# events fire. Set it once the GA4 property exists, then mark lead_call,
# lead_whatsapp and lead_form_submit as key events (conversions) in the GA4 UI.
# The Google Ads campaign must not start spending until those three are
# confirmed firing.
NEXT_PUBLIC_GA4_ID=
